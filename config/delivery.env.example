# Copy these variables into a LOCAL .env. Never commit real secret values.
# Simulation by default; false is honored only by config.delivery_test_settings.
LRSTOCK_DELIVERY_SIMULATE=true
LRSTOCK_EMAIL_SENDER=info@label-ci.com
LRSTOCK_TEST_EMAILS=
LRSTOCK_TEST_PHONES=

# application = Microsoft 365 organization, with tenant and application secret.
# personal = Outlook.com personal account, connected with manage.py connect_outlook.
LRSTOCK_MS_AUTH_MODE=application
# Microsoft Entra application; personal mode only uses its client ID.
LRSTOCK_MS_TENANT_ID=
LRSTOCK_MS_CLIENT_ID=
LRSTOCK_MS_CLIENT_SECRET=

# Meta WhatsApp Cloud API test sender and approved templates
LRSTOCK_WA_TOKEN=
LRSTOCK_WA_PHONE_ID=
LRSTOCK_WA_VERSION=
LRSTOCK_WA_PDF_TEMPLATE=lrstock_document
LRSTOCK_WA_IMAGE_TEMPLATE=lrstock_image
LRSTOCK_WA_LANGUAGE=fr
