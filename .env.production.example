# Variables pour le déploiement cloud (Docker). Copier en .env et remplir.
# Ne jamais versionner le fichier .env réel.

# Générer une clé : python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=a-remplacer-par-une-cle-longue-et-aleatoire
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=votre-domaine.com,www.votre-domaine.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://votre-domaine.com,https://www.votre-domaine.com
DJANGO_BEHIND_HTTPS_PROXY=True
DJANGO_SERVE_MEDIA=True

# PostgreSQL. Avec docker-compose, ENGINE/HOST/PORT sont fournis automatiquement ;
# avec une base PostgreSQL managée par l'hébergeur, renseigner DATABASE_HOST.
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=gestion_stock
DATABASE_USER=gestion_stock
DATABASE_PASSWORD=mot-de-passe-fort
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_CONN_MAX_AGE=60

REDIS_URL=redis://redis:6379/0
CELERY_WORKER_POOL=solo
GUNICORN_WORKERS=3

# Intégrations optionnelles
MISTRAL_API_KEY=
MISTRAL_AGENT_ID=
MISTRAL_MODEL=mistral-medium-latest
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
